precision highp float;

attribute vec3 pos;
uniform float time;
uniform mat4 rot;

vec3 continiumRoom(vec3 p, float t){

    // directV3 – deterministische Achsen
    vec3 D3 = vec3(
        sin(t * 0.71),
        cos(t * 0.89),
        sin(t * 1.37)
    );

    // Prefetcher 3×1
    vec3 P31 = D3;

    // Prefetcher 3×3 (outer product, branchless)
    mat3 P33 = mat3(
        D3.x * D3.x, D3.x * D3.y, D3.x * D3.z,
        D3.y * D3.x, D3.y * D3.y, D3.y * D3.z,
        D3.z * D3.x, D3.z * D3.y, D3.z * D3.z
    );

    // 756‑Achsen – komprimierte atomare Achsenfunktion
    float axis = 
          sin(p.x * 12.0 + t * 0.91)
        + cos(p.y *  9.0 + t * 0.53)
        + sin(p.z *  7.0 + t * 1.27);

    // Zeit‑Morph – High‑Precision
    vec3 morph = vec3(
        sin(t + p.x * 0.97),
        cos(t + p.y * 1.11),
        sin(2.0 * t + p.z * 0.83)
    );

    // CONTINIUM.room Operator – High‑End
    vec3 room =
          (P33 * p)          // Raum‑Matrix
        + (P31 * axis)       // Achsen‑Einbettung
        + (morph * 0.12);    // Zeit‑Morph

    return room;
}

void main(){
    vec3 r = continiumRoom(pos, time);
    gl_Position = rot * vec4(r, 1.0);
    gl_PointSize = 8.0;
}
