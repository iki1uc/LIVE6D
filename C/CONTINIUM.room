function continiumRoom(p, t){
    const D3 = {
        x: Math.sin(t * 0.7),
        y: Math.cos(t * 0.9),
        z: Math.sin(t * 1.3)
    };

    const P31 = D3;

    const P33 = [
        D3.x * D3.x, D3.x * D3.y, D3.x * D3.z,
        D3.y * D3.x, D3.y * D3.y, D3.y * D3.z,
        D3.z * D3.x, D3.z * D3.y, D3.z * D3.z
    ];

    const axis =
        Math.sin(p.x * 12 + t) +
        Math.cos(p.z * 9 + t * 0.5) +
        Math.sin(p.y * 7 + t * 1.3);

    const morph = {
        x: Math.sin(t + p.x),
        y: Math.cos(t + p.y),
        z: Math.sin(2 * t + p.z)
    };

    return {
        x: P33[0] * p.x + P33[1] * p.y + P33[2] * p.z + P31.x * axis + morph.x * 0.1,
        y: P33[3] * p.x + P33[4] * p.y + P33[5] * p.z + P31.y * axis + morph.y * 0.1,
        z: P33[6] * p.x + P33[7] * p.y + P33[8] * p.z + P31.z * axis + morph.z * 0.1
    };
}
