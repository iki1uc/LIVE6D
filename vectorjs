precision highp float;

uniform float time;

void main(){

    // Energie‑Vektor (atomar, branchless)
    float e =
          abs(sin(time * 0.71))
        + abs(cos(time * 0.43))
        + abs(sin(time * 1.29));

    float n = clamp(e * 0.33, 0.0, 1.0);

    vec3 low  = vec3(0.0, 0.2, 1.0);  // Blau
    vec3 high = vec3(1.0, 0.0, 0.0);  // Rot

    vec3 color = mix(low, high, n);

    gl_FragColor = vec4(color, 1.0);
}
